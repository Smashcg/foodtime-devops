{
  "name": "foodtime-devops",
  "version": "1.0.0",
  "description": "Projeto Prático de DevOps - Aplicação FoodTime com CI/CD e IaC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "github-actions",
    "terraform",
    "aws",
    "express",
    "jest"
  ],
  "author": "Patrick",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "controller/**/*.js"
    ]
  }
}

